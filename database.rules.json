{
  "rules": {
    ".read": false,
    ".write": false,

    "tripLedgerData": {
      ".read": "auth != null && auth.token.email_verified == true",
      ".write": false
    },

    "ledgerTrips": {
      "$tripId": {
        ".read": "auth != null && auth.token.email_verified == true && (data.child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists() || (data.child('invite').exists() && data.child('joins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === data.child('invite').val()))",
        ".write": "auth != null && auth.token.email_verified == true && (data.child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists() || (data.child('invite').exists() && data.child('joins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === data.child('invite').val()) || (!data.exists() && newData.child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))",

        "joins": {
          "$emailKey": {
            ".write": "auth != null && auth.token.email_verified == true && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && root.child('ledgerTrips').child($tripId).child('invite').exists() && newData.val() === root.child('ledgerTrips').child($tripId).child('invite').val()"
          }
        }
      }
    },

    "ledgerUserTrips": {
      "$emailKey": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase().replace('.', ',') === $emailKey",
        "$tripId": {
          ".write": "auth != null && auth.token.email_verified == true && (root.child('ledgerTrips').child($tripId).child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists() || (auth.token.email.toLowerCase().replace('.', ',') === $emailKey && !newData.exists()))"
        }
      }
    }
  }
}
