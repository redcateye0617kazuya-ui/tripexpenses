{
  "rules": {
    ".read": false,
    ".write": false,

    "tripLedgerData": {
      ".read": "auth != null && auth.token.email_verified == true",
      ".write": false
    },

    "ledgerTrips": {
      "$tripId": {
        ".read": "auth != null && auth.token.email_verified == true && data.child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists()",
        ".write": "auth != null && auth.token.email_verified == true && (data.child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists() || (!data.exists() && newData.child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists()))"
      }
    },

    "ledgerUserTrips": {
      "$emailKey": {
        ".read": "auth != null && auth.token.email_verified == true && auth.token.email.toLowerCase().replace('.', ',') === $emailKey",
        "$tripId": {
          ".write": "auth != null && auth.token.email_verified == true && (root.child('ledgerTrips').child($tripId).child('allow').child(auth.token.email.toLowerCase().replace('.', ',')).exists() || (auth.token.email.toLowerCase().replace('.', ',') === $emailKey && !newData.exists()))"
        }
      }
    }
  }
}
